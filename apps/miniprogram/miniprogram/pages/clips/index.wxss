.line, .intro, .clip-info > text { display: block; }
.intro { margin-bottom: 34rpx; }
.filters { display: flex; gap: 24rpx; margin-bottom: 30rpx; }
.filters button { width: 50%; background: #eaeae5; border-radius: 12rpx; font-size: 26rpx; }
.filters button.selected { background: #222; color: #fafaf7; }
.clip-row { display: flex; align-items: center; gap: 22rpx; border: 2rpx solid #deded7; padding: 20rpx; border-radius: 16rpx; margin-bottom: 18rpx; }
.thumbnail { background: #e7e7e1; width: 128rpx; height: 116rpx; flex-shrink: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; font-size: 42rpx; border-radius: 10rpx; }
.small { font-size: 21rpx; }
.clip-info { flex: 1; min-width: 0; }
.clip-title { font-size: 28rpx; font-weight: 700; }
.clip-info .muted { margin-top: 10rpx; }
.list-footer { margin-top: 40rpx; text-align: center; }
.list-footer > text { font-size: 23rpx; }
.secondary { margin: 28rpx 0; }
.card text { display: block; }
.back-link { margin: 30rpx 0; }
