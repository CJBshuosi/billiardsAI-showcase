page { background: #fff; color: #111; font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif; font-size: 28rpx; line-height: 1.55; }
view, button, input, navigator { box-sizing: border-box; }
text { display: block; overflow-wrap: break-word; }
button { margin: 0; font-size: 28rpx; line-height: 1.4; padding: 24rpx 26rpx; border-radius: 18rpx; background: #f2f2f0; color: #111; }
button::after { border: 0; }
button[disabled] { color: #666; background: #efefed; border-color: #d9d9d5; box-shadow: none; }
navigator { color: inherit; }
.page-shell { padding: 34rpx 36rpx calc(42rpx + env(safe-area-inset-bottom)); max-width: 1000rpx; margin: 0 auto; }
.nav-space { padding-bottom: calc(186rpx + env(safe-area-inset-bottom)); }
.hero, .heading { font-size: 60rpx; font-weight: 900; line-height: 1.2; letter-spacing: -2rpx; margin: 24rpx 0 26rpx; }
.hero.small { font-size: 48rpx; }
.eyebrow { font-size: 24rpx; font-weight: 700; margin-bottom: 18rpx; }
.muted, .detail { color: #666; font-size: 25rpx; }
.tiny { color: #666; font-size: 22rpx; }
.section-title { font-size: 34rpx; font-weight: 800; margin: 34rpx 0 20rpx; }
.state { font-weight: 800; font-size: 32rpx; }
.card { background: #f2f2f0; padding: 30rpx; border-radius: 22rpx; margin: 24rpx 0; }
.card text + text { margin-top: 12rpx; }
.outlined { border: 3rpx solid #111; background: #fff; }
.row { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.row > button, .row > navigator { flex: 1; min-width: 0; }
.stack { display: flex; flex-direction: column; gap: 20rpx; }
.primary { background: #fff; border: 4rpx solid #111; border-radius: 18rpx; box-shadow: 6rpx 7rpx 0 #111; padding: 24rpx; text-align: center; font-weight: 800; margin: 26rpx 6rpx 30rpx 0; display: block; }
.primary.dark { color: #fff; background: #111; }
.secondary { display: block; border: 2rpx solid #d9d9d5; border-radius: 18rpx; padding: 24rpx; text-align: center; background: #f2f2f0; font-weight: 600; }
.list-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 28rpx 0; border-bottom: 2rpx solid #e6e6e2; min-height: 96rpx; }
.list-row .label { font-size: 30rpx; font-weight: 700; }
.chevron { color: #111; font-size: 36rpx; flex-shrink: 0; }
.pill { display: inline-block; border-radius: 10rpx; background: #f2f2f0; color: #666; padding: 8rpx 16rpx; font-size: 22rpx; }
.error, .feedback { background: #f2f2f0; border-left: 5rpx solid #111; padding: 24rpx; margin: 24rpx 0; border-radius: 8rpx; }
.error button, .feedback button { border: 2rpx solid #111; margin-top: 18rpx; background: #fff; }
.metric-grid { display: flex; gap: 20rpx; margin: 28rpx 0; }
.metric { flex: 1; min-width: 0; background: #f2f2f0; border-radius: 22rpx; padding: 28rpx; }
.metric-value { font-size: 50rpx; font-weight: 900; line-height: 1.3; margin-bottom: 10rpx; }
.footer-actions { margin-top: 36rpx; padding-top: 20rpx; border-top: 2rpx solid #e4e4e0; }
.danger { border: 2rpx solid #111; background: #fff; margin-top: 24rpx; }
.field-input { height: 100rpx; border: 3rpx solid #111; border-radius: 16rpx; padding: 0 24rpx; margin: 20rpx 0; background: #fff; font-size: 30rpx; }
.tab-row { display: flex; gap: 18rpx; margin: 26rpx 0; }
.tab-row button { flex: 1; }
.tab-row .selected { background: #111; color: #fff; font-weight: 800; }
.divider { border-top: 2rpx solid #e4e4e0; margin: 30rpx 0; }
.link { text-decoration: underline; font-weight: 700; }
.empty { padding: 36rpx 0; }
